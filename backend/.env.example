# Copy this file to .env and replace the placeholder values with your actual Render/Vercel credentials.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-backend-name.onrender.com,localhost,127.0.0.1

# Fill these with values from your Render PostgreSQL service.
DB_NAME=your_render_postgres_db_name
DB_USER=your_render_postgres_user
DB_PASSWORD=your_render_postgres_password
DB_HOST=your_render_postgres_host
DB_PORT=5432

# Replace with your Vercel frontend URL(s).
CORS_ALLOWED_ORIGINS=https://your-frontend-name.vercel.app,https://www.your-frontend-name.vercel.app,http://localhost:5173,http://127.0.0.1:5173

TAVERN_WHATSAPP_NUMBER=254700000000
